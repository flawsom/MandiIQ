            window.open(DEPLOY.DASH, '_blank');
        });

        /* Text Scramble */
        class Scrambler {
            constructor(el) {
                this.el = el;
                this.chars = '!<>-_\\/[]{}—=+*^?#________';
                this.update = this.update.bind(this);
            }
            setText(newText) {
                const oldText = this.el.innerText;
                const len = Math.max(oldText.length, newText.length);
                this.queue = [];
                for (let i = 0; i < len; i++) {
                    const from = oldText[i] || '';
                    const to = newText[i] || '';
                    this.queue.push({
                        from, to,
                        start: Math.floor(Math.random() * 38),
                        end: Math.floor(Math.random() * 38) + 10,
                    });
                }
                cancelAnimationFrame(this.frameId);
                this.frame = 0;
                this.update();
            }
            update() {
                let out = '', complete = 0;
                for (const item of this.queue) {
                    if (this.frame >= item.end) { complete++; out += item.to; }
                    else if (this.frame >= item.start) {
                        out += `<span style="color:var(--color-primary)">${this.chars[Math.floor(Math.random() * this.chars.length)]}</span>`;
                    } else { out += item.from; }
                }
                this.el.innerHTML = out;
                if (complete === this.queue.length) return;
                this.frameId = requestAnimationFrame(this.update);
                this.frame++;
            }
        }
        document.querySelectorAll('[data-scramble]').forEach(el => {
            const orig = el.innerText;
            const s = new Scrambler(el);
            el.addEventListener('mouseenter', () => s.setText(orig));
        });

        /* Scroll Reveal */
        const revealObserver = new IntersectionObserver(entries => {
            entries.forEach(e => {
                if (e.isIntersecting) {
                    e.target.classList.add('is-visible');
                    revealObserver.unobserve(e.target);
                }
            });
        }, { threshold: 0.1 });
        document.querySelectorAll('.reveal').forEach(el => revealObserver.observe(el));

        /* Surface Mode Toggle (replication prompt §8) */
        (function() {
            function applySurface(enabled) {
                document.body.classList.toggle('theme-surface', enabled);
                const btn = document.getElementById('surface-toggle');
                if (btn) {
                    btn.innerHTML = enabled
                        ? '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>'
                        : '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/></svg>';
                }
                localStorage.setItem('ambient_surface', enabled ? '1' : '0');
            }
            // Restore saved preference
            if (localStorage.getItem('ambient_surface') === '1') applySurface(true);
            // Toggle button click
            document.getElementById('surface-toggle')?.addEventListener('click', function() {
                applySurface(!document.body.classList.contains('theme-surface'));
            });
            // Cross-tab sync
            window.addEventListener('storage', function(e) {
                if (e.key === 'ambient_surface') applySurface(e.newValue === '1');
            });
        })();
    </script>
