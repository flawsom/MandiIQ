<file path="diagrams/architecture.mmd">
---
title: MandiIQ System Architecture
---
graph TB
    subgraph Sources["📡 Data Sources"]
        AGMARKNET["Agmarknet API<br/>Daily Mandi Prices"]
        ASHOKA["Ashoka CEDA Archive<br/>Historical Price CSV"]
        IMD["IMD Weather Grids<br/>Rainfall Departure (%)"]
        SENTINEL["Sentinel Hub<br/>NDVI Satellite Data"]
    end
    subgraph Ingestion["📥 Ingestion Pipeline"]
        FETCH_PRICES["fetch_prices.py<br/>Pagination + Retry"]
        FETCH_VARIETYWISE["fetch_prices.py<br/>(Variety-Wise Archive)<br/>80M-row Probe + Scan"]
        INGEST_CSV["ingest_historical_csv.py<br/>CSV Backfill + Ashoka"]
        FETCH_RAINFALL["fetch_rainfall.py<br/>Sub-division Rainfall"]
        FETCH_NDVI["fetch_ndvi.py<br/>Vegetation Index"]
        SCHEDULER["scheduler.py<br/>Orchestration"]
        HTTP_CLIENT["http_client.py<br/>Shared HTTP with Retry"]
    end
    subgraph Storage["🗄️ Storage Layer"]
        DUCKDB["DuckDB Warehouse<br/>mandi_iq.duckdb"]
        TABLES["Analytical Tables:<br/>prices, rainfall,<br/>ndvi, rdd_results"]
        LINEAGE["🔍 data_lineage<br/>Batch Provenance<br/>Source Fingerprint<br/>Commodity List<br/>Ingestion Timestamp"]
        FRESHNESS_TABLE["📊 freshness_by_commodity<br/>Per-Commodity Stats:<br/>Latest Date · Row Count<br/>District Coverage · Source"]
        LAST_STATUS["last_ingest_status.json<br/>Run Timestamp"]
    end
    subgraph Analysis["🧮 Analysis Engine"]
        RDD_ENGINE["rdd_engine.py<br/>RDD Specification<br/>Local Linear Regression"]
        FORECAST["forecast.py<br/>Prophet + XGBoost<br/>Volatility Envelopes"]
        CLASSIFIER["classifier.py<br/>Spike Risk Scoring"]
        PRESCRIPTIVE["prescriptive.py<br/>Procurement Recommendations"]
    end
    subgraph AI["🤖 AI Orchestrator"]
        ROUTER["router.py<br/>Multi-Provider LLM<br/>Circuit Breaker"]
        ORCHESTRATOR["orchestrator.py<br/>Tool Selection<br/>Grounded Answering"]
        NARRATIVE["Nightly Narratives<br/>Commodity Reports"]
    end
    subgraph Serving["🌐 Serving Layer"]
        FASTAPI["FastAPI Gateway<br/>(mandiiq-api.onrender.com)"]
        ENDPOINTS["Endpoints:<br/>/health /prices /rdd-result<br/>/forecast /risk-score<br/>/ask /refresh /metrics<br/>/freshness /lineage"]
        STREAMLIT["Streamlit Dashboard<br/>(mandiiq.streamlit.app)<br/>Data Freshness Widget"]
    end
    subgraph Monitoring["📈 Observability"]
        PROMETHEUS["/metrics Endpoint<br/>Pipeline Latency<br/>Step Durations<br/>API Call Counters"]
        FRESHNESS_API["/freshness<br/>Per-Commodity Freshness"]
        LINEAGE_API["/lineage<br/>Ingestion Batch Trace"]
        HEALTH["/health<br/>Liveness + Data Counts"]
        GRAFANA["Grafana / Prometheus<br/>(Optional Scraping)"]
        CHECK_FRESHNESS["check-freshness.py<br/>Daily Cron → GitHub Issue<br/>48h Stale Detection"]
    end
