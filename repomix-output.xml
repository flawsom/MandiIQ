    <script>
        /* Deploy URLs */
        const DEPLOY = {
            API: 'https://your-api.onrender.com',
            DASH: 'https://your-dashboard.onrender.com',
        };
        document.getElementById('dashboard-link')?.addEventListener('click', e => {
