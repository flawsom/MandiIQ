        .flip-board-root {
          display: flex;
          flex-wrap: wrap;
          gap: 1rem;
          padding: 0.75rem 0;
          font-family: 'IBM Plex Mono', 'JetBrains Mono', 'Fira Code', monospace;
          background: ${wn.bg};
        }

        .flip-kpi-card {
          flex: 1 1 200px;
          background: linear-gradient(135deg, ${wn.glass} 0%, rgba(255,255,255,0.005) 100%);
          border: 1px solid ${wn.hairline};
          border-radius: 8px;
          padding: 1.2rem 1.2rem;
          min-width: 160px;
          position: relative;
          overflow: hidden;
          transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1),
                      border-color 0.35s ease;
        }

        /* Crosshair corner markers — Studio active-target pattern */
        .flip-kpi-card::before {
          content: '';
          position: absolute;
          top: -1px;
          left: -1px;
          width: 10px;
          height: 10px;
          border-top: 1.5px solid ${wn.primary};
          border-left: 1.5px solid ${wn.primary};
          opacity: 0;
          transition: opacity 0.35s ease;
          pointer-events: none;
        }

        .flip-kpi-card::after {
          content: '';
          position: absolute;
          bottom: -1px;
          right: -1px;
          width: 10px;
          height: 10px;
          border-bottom: 1.5px solid ${wn.primary};
          border-right: 1.5px solid ${wn.primary};
          opacity: 0;
          transition: opacity 0.35s ease;
          pointer-events: none;
        }

        .flip-kpi-card:hover::before,
        .flip-kpi-card:hover::after {
          opacity: 1;
        }

        .flip-kpi-card:hover {
          border-color: rgba(215, 255, 0, 0.15);
          transform: translateY(-2px);
        }

        .flip-kpi-label {
          font-family: 'IBM Plex Sans', 'Inter', system-ui, sans-serif;
          font-size: 0.68rem;
          font-weight: 500;
          text-transform: uppercase;
          letter-spacing: 0.06em;
          color: ${wn.textMed};
          margin-bottom: 0.5rem;
        }

        .flip-kpi-value {
          display: flex;
          align-items: baseline;
          gap: 4px;
        }

        .flip-kpi-prefix,
        .flip-kpi-suffix {
          font-size: 0.95rem;
          color: ${wn.textMed};
          font-weight: 500;
