    <script>
        /* Text Scramble */
        class Scrambler {
            constructor(el) {
                this.el = el;
                this.chars = '!<>-_\\/[]{}—=+*^?#________';
                this.update = this.update.bind(this);
            }
            setText(newText) {
                const oldText = this.el.innerText;
                const len = Math.max(oldText.length, newText.length);
                this.queue = [];
                for (let i = 0; i < len; i++) {
                    const from = oldText[i] || '';
                    const to = newText[i] || '';
                    this.queue.push({
                        from, to,
                        start: Math.floor(Math.random() * 38),
                        end: Math.floor(Math.random() * 38) + 10,
                    });
                }
                cancelAnimationFrame(this.frameId);
                this.frame = 0;
                this.update();
            }
            update() {
                let out = '', complete = 0;
                for (const item of this.queue) {
                    if (this.frame >= item.end) { complete++; out += item.to; }
                    else if (this.frame >= item.start) {
                        out += `<span style="color:var(--color-primary)">${this.chars[Math.floor(Math.random() * this.chars.length)]}</span>`;
                    } else { out += item.from; }
                }
                this.el.innerHTML = out;
                if (complete === this.queue.length) return;
                this.frameId = requestAnimationFrame(this.update);
                this.frame++;
            }
        }
        document.querySelectorAll('[data-scramble]').forEach(el => {
            const orig = el.innerText;
            const s = new Scrambler(el);
            el.addEventListener('mouseenter', () => s.setText(orig));
        });

        /* Scroll Reveal */
        const revealObserver = new IntersectionObserver(entries => {
            entries.forEach(e => {
                if (e.isIntersecting) {
                    e.target.classList.add('is-visible');
                    revealObserver.unobserve(e.target);
                }
            });
        }, { threshold: 0.1 });
        document.querySelectorAll('.reveal').forEach(el => revealObserver.observe(el));
    </script>
