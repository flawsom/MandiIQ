<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Margin Intelligence System — Loss Prevention Platform</title>
    <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Cpath d='M16 2L6 12h6v18h8V12h6L16 2z' fill='%23d7ff00'/%3E%3C/svg%3E">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600&family=IBM+Plex+Sans:wght@300;400;500;600&family=Space+Grotesk:wght@300;400;500;600;700&family=Barlow:wght@300;400;500;600;700&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet">
    <style>
        /* ═══════════════════════════════════════════════════════════
           1. DESIGN TOKENS — MandiIQ Inspired
           ═══════════════════════════════════════════════════════════ */
        :root {
            --bg-base: #000000;
            --bg-surface: #0a0a0a;
            --bg-glass: rgba(255,255,255,0.03);
            --bg-glass-hover: rgba(255,255,255,0.06);
            --bg-surface-glass: rgba(255,255,255,0.02);

            --font-display: "Space Grotesk", system-ui, -apple-system, sans-serif;
            --font-body: "IBM Plex Sans", "Inter", system-ui, sans-serif;
            --font-mono: "IBM Plex Mono", "JetBrains Mono", monospace;
            --font-numeric: "Barlow", "IBM Plex Sans", sans-serif;

            --color-primary: #d7ff00;
            --color-paper: #ffffff;
            --color-text-high: #bababa;
            --color-text-med: #7e7e7e;
            --color-text-low: #555555;
            --color-rust: #D9663B;
            --color-sage: #8FAE89;

            --hairline: rgba(255,255,255,0.07);
            --hairline-strong: rgba(255,255,255,0.14);

            --duration-base: 350ms;
            --duration-slow: 600ms;
            --ease-bounce: cubic-bezier(0.16, 1, 0.3, 1);
            --ease-soft: cubic-bezier(0.25, 0.46, 0.45, 0.94);
        }

        * { margin: 0; padding: 0; box-sizing: border-box; }

        html, body {
            background-color: var(--bg-base);
            color: var(--color-text-high);
            font-family: var(--font-body);
            font-size: 15px;
            line-height: 1.625;
            -webkit-font-smoothing: antialiased;
            -moz-osx-font-smoothing: grayscale;
            overflow-x: hidden;
            scroll-behavior: smooth;
        }

        /* ── Dot Grid ── */
        .dot-grid {
            position: fixed; top: 0; left: 0;
            width: 100vw; height: 100vh;
            background-image: radial-gradient(rgba(255,255,255,0.04) 1.5px, transparent 2px);
            background-size: 38px 38px;
            z-index: 0; pointer-events: none;
        }

        /* ── Atmosphere Blobs ── */
        .atmosphere {
            position: fixed; top: 0; left: 0;
            width: 100vw; height: 100vh;
            overflow: hidden; z-index: 0; pointer-events: none;
        }
        .atmosphere-flash {
            position: absolute; top: -20%; right: -10%;
            width: 70vw; height: 60vh;
            background: radial-gradient(circle, rgba(215,255,0,0.04) 0%, transparent 70%);
            filter: blur(100px);
            animation: drift-a 45s var(--ease-soft) infinite alternate;
        }
        .atmosphere-cloud {
            position: absolute; bottom: -20%; left: -10%;
            width: 80vw; height: 70vh;
            background: radial-gradient(circle, rgba(255,255,255,0.02) 0%, transparent 70%);
            filter: blur(120px);
            animation: drift-b 55s var(--ease-soft) infinite alternate;
        }
        .atmosphere-drifter {
            position: absolute;
            width: var(--s,160px); height: var(--s,160px);
            left: var(--x,50%); top: var(--y,50%);
            border-radius: 50%;
            background: radial-gradient(circle, hsla(var(--hue,100),var(--sat,0.8),var(--lit,0.55),var(--op,0.06)) 0%, transparent 70%);
            filter: blur(80px);
            animation: drifter-float var(--d,30s) var(--ease-soft) infinite alternate;
            will-change: transform;
        }
        @keyframes drifter-float {
            0%   { transform: translate(0,0) scale(1) rotate(0deg); }
            25%  { transform: translate(5%,-5%) scale(1.15) rotate(8deg); }
            50%  { transform: translate(-3%,3%) scale(0.95) rotate(-5deg); }
            75%  { transform: translate(4%,-2%) scale(1.08) rotate(3deg); }
            100% { transform: translate(-5%,5%) scale(1.05) rotate(-4deg); }
        }
        @keyframes drift-a { from { transform: translate(0,0) scale(1); } to { transform: translate(-8%,10%) scale(1.1); } }
        @keyframes drift-b { from { transform: translate(0,0) scale(1.1); } to { transform: translate(10%,-8%) scale(0.95); } }

        .page-wrap {
            position: relative; z-index: 1;
            max-width: 1200px; margin: 0 auto; padding: 0 2rem;
        }

        /* ═══════════════════════════════════════════════════════════
           2. HEADER
           ═══════════════════════════════════════════════════════════ */
        header {
            display: flex; align-items: center; justify-content: space-between;
            padding: 2rem 0;
            border-bottom: 1px solid var(--hairline);
        }
        .logo-group { display: flex; align-items: center; gap: 0.75rem; }
        .logo-icon {
            width: 20px; height: 20px;
            background: var(--color-primary);
            clip-path: polygon(0 0, 100% 0, 100% 50%, 50% 100%, 0 50%);
        }
        .logo-text {
            font-family: var(--font-display);
            font-weight: 500; font-size: 1rem;
            letter-spacing: 0.12em; color: var(--color-paper);
            text-transform: uppercase;
        }
        nav { display: flex; align-items: center; gap: 2rem; }
        .nav-link {
            font-family: var(--font-mono);
            font-size: 0.75rem; color: var(--color-text-med);
            text-decoration: none; text-transform: uppercase;
            letter-spacing: 0.08em;
            transition: color var(--duration-base) var(--ease-soft);
            cursor: pointer;
        }
        .nav-link:hover { color: var(--color-primary); }

        /* ═══════════════════════════════════════════════════════════
           3. HERO
           ═══════════════════════════════════════════════════════════ */
        .hero {
            padding: 5rem 0 3rem;
            position: relative;
            min-height: 80vh;
            display: flex; flex-direction: column; justify-content: center;
        }
        .hero-frame {
            position: relative; padding: 2.5rem;
            margin-bottom: 2rem;
        }
        .hero-frame-svg {
            position: absolute; top: 0; left: 0;
            width: 100%; height: 100%; pointer-events: none; overflow: visible;
        }
        .hero-frame-svg rect {
            fill: none; stroke: var(--hairline-strong);
            stroke-width: 1px; stroke-dasharray: 2000; stroke-dashoffset: 2000;
            animation: drawFrame 2.8s var(--ease-bounce) forwards 0.2s;
        }
        .hero-frame-svg line {
            stroke: var(--color-primary); stroke-width: 1.5px;
            stroke-dasharray: 100; stroke-dashoffset: 100;
            animation: drawLine 1.8s var(--ease-bounce) forwards 0.8s;
        }
        @keyframes drawFrame { to { stroke-dashoffset: 0; } }
        @keyframes drawLine { to { stroke-dashoffset: 0; } }

        .hero-tagline {
            font-family: var(--font-mono); font-size: 0.8rem;
            color: var(--color-primary); text-transform: uppercase;
            letter-spacing: 0.18em; margin-bottom: 1rem;
            display: inline-flex; align-items: center; gap: 0.5rem;
        }
        .hero-tagline::before {
            content: ""; display: inline-block;
            width: 5px; height: 5px; background: var(--color-primary);
        }
        .hero h1 {
            font-family: var(--font-display); font-weight: 300;
            font-size: clamp(2rem, 5vw, 4.2rem); line-height: 1.1;
            color: var(--color-paper); letter-spacing: 0.03em;
            text-transform: uppercase; margin-bottom: 1.5rem;
        }
        .hero h1 .hl { color: var(--color-primary); font-weight: 600; }
        .hero h1 .hl-loss { color: var(--color-rust); font-weight: 600; }
        .hero-desc {
            font-size: 1.05rem; color: var(--color-text-high);
            max-width: 700px; line-height: 1.7; margin-bottom: 2.5rem;
        }
        .hero-actions { display: flex; align-items: center; gap: 1.2rem; flex-wrap: wrap; }

        /* ── SlotButton ── */
        .slot-btn {
            position: relative; display: inline-block;
            color: var(--color-paper); text-decoration: none;
            overflow: hidden;
            padding: 0.6rem 1.5rem;
            border: 1px solid var(--hairline-strong); border-radius: 999px;
            background: transparent; cursor: pointer;
            font-family: var(--font-mono); font-size: 0.78rem;
            font-weight: 500; letter-spacing: 0.08em;
            transition: background-color var(--duration-base) var(--ease-soft),
                        border-color var(--duration-base) var(--ease-soft);
        }
        .slot-btn:hover { background-color: var(--color-primary); border-color: var(--color-primary); }
        .slot-text-wrapper {
            position: relative; display: block;
            transition: transform 0.45s var(--ease-bounce);
        }
        .slot-text-default { display: block; transition: opacity 0.3s var(--ease-soft), transform 0.45s var(--ease-bounce); }
        .slot-text-hover {
            position: absolute; top: 100%; left: 0; width: 100%; display: block;
            color: var(--bg-base); font-weight: 600;
            pointer-events: none; opacity: 0;
            transform: translateY(-50%) scale(0.95);
            transition: opacity 0.3s var(--ease-soft), transform 0.45s var(--ease-bounce);
        }
        .slot-btn:hover .slot-text-wrapper { transform: translateY(-100%); }
        .slot-btn:hover .slot-text-default { opacity: 0; transform: scale(0.9); }
        .slot-btn:hover .slot-text-hover { opacity: 1; transform: translateY(-50%) scale(1); }
        .slot-btn::after {
            content: ""; position: absolute; bottom: -1px; left: 50%;
            width: 0; height: 1px;
            background: var(--color-primary);
            transition: width 0.4s var(--ease-bounce), left 0.4s var(--ease-bounce);
            pointer-events: none;
        }
        .slot-btn:hover::after { width: 80%; left: 10%; }

        .btn-outline {
            display: inline-block;
            font-family: var(--font-mono); font-size: 0.75rem;
            text-transform: uppercase; letter-spacing: 0.08em;
            text-decoration: none;
            color: var(--color-text-high);
            padding: 0.55rem 1.4rem;
            border: 1px solid var(--hairline); border-radius: 999px;
            transition: all var(--duration-base) var(--ease-soft);
        }
        .btn-outline:hover { color: var(--color-paper); border-color: var(--color-paper); }

        /* Tech Pills */
        .tech-pills {
            display: flex; flex-wrap: wrap; gap: 0.5rem;
            margin-top: 2.5rem;
        }
        .tech-pill {
            font-family: var(--font-mono); font-size: 0.7rem;
            padding: 0.25rem 0.7rem;
            border-radius: 999px;
            background: rgba(255,255,255,0.03);
            border: 1px solid var(--hairline);
            color: var(--color-text-med);
            text-transform: uppercase;
            transition: all var(--duration-base) var(--ease-soft);
        }
        .tech-pill:hover {
            border-color: rgba(215,255,0,0.3);
            color: var(--color-paper);
            background: rgba(215,255,0,0.04);
        }

        /* ═══════════════════════════════════════════════════════════
           4. SECTIONS
           ═══════════════════════════════════════════════════════════ */
        section { padding: 4rem 0; border-bottom: 1px solid var(--hairline); }
        .section-label {
            font-family: var(--font-mono); font-size: 0.75rem;
            color: var(--color-primary); letter-spacing: 0.1em;
            margin-bottom: 0.8rem; display: block;
        }
        .section-title {
            font-family: var(--font-display); font-weight: 400;
            font-size: 1.6rem; color: var(--color-paper);
            text-transform: uppercase; letter-spacing: 0.05em;
            margin-bottom: 2rem;
        }

        /* ── Glass Cards ── */
        .kpi-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
            gap: 1.2rem; margin-bottom: 3rem;
        }
        .glass-card {
            background: linear-gradient(135deg, rgba(255,255,255,0.03) 0%, rgba(255,255,255,0.005) 100%);
            border: 1px solid var(--hairline); border-radius: 8px;
            padding: 1.6rem;
            transition: transform 0.35s var(--ease-bounce), border-color 0.35s ease, box-shadow 0.35s ease;
            position: relative;
        }


        .glass-card::before {
            content: ""; position: absolute;
            top: -1px; left: -1px;
            width: 10px; height: 10px;
            border-top: 1.5px solid var(--color-primary);
            border-left: 1.5px solid var(--color-primary);
            opacity: 0; transition: opacity var(--duration-base) ease;
            pointer-events: none;
        }
        .glass-card::after {
            content: ""; position: absolute;
            bottom: -1px; right: -1px;
            width: 10px; height: 10px;
            border-bottom: 1.5px solid var(--color-primary);
            border-right: 1.5px solid var(--color-primary);
            opacity: 0; transition: opacity var(--duration-base) ease;
            pointer-events: none;
        }
        .glass-card:hover::before, .glass-card:hover::after { opacity: 1; }
        .glass-card:hover { border-color: rgba(215,255,0,0.15); transform: translateY(-2px); box-shadow: 0 8px 24px rgba(0,0,0,0.4); }

        /* ── Glass backdrop (replication prompt §4) ── */
        .glass {
            background: linear-gradient(135deg, rgba(255,255,255,0.03) 0%, rgba(255,255,255,0.01) 100%);
            backdrop-filter: blur(14px) saturate(140%);
            -webkit-backdrop-filter: blur(14px) saturate(140%);
            border: 1px solid var(--hairline);
            border-radius: 8px;
            box-shadow: 0 8px 32px rgba(0,0,0,0.5);
            transition: transform 0.35s var(--ease-bounce), box-shadow 0.35s ease, border-color 0.35s ease;
        }
        .glass:hover {
            transform: translateY(-4px);
            box-shadow: 0 14px 44px rgba(0,0,0,0.7), 0 0 0 1px rgba(215,255,0,0.15);
            border-color: var(--color-primary);
        }
        .card-label {
            font-family: var(--font-mono); font-size: 0.7rem;
            color: var(--color-text-med); text-transform: uppercase;
            letter-spacing: 0.08em; margin-bottom: 0.6rem;
        }
        .card-value {
            font-family: var(--font-mono); font-size: 2rem;
            font-weight: 500; color: var(--color-paper); line-height: 1.1;
            margin-bottom: 0.4rem;
        }
        .card-value.accent { color: var(--color-primary); }
        .card-meta { font-size: 0.78rem; color: var(--color-text-med); }

        /* ── Ledger Table ── */
        .table-responsive {
            width: 100%; overflow-x: auto;
            border: 1px solid var(--hairline);
            background: rgba(10,10,10,0.4); border-radius: 4px;
        }
        .ledger { width: 100%; border-collapse: collapse; font-size: 0.88rem; }
        .ledger th {
            padding: 0.9rem 1.2rem; color: var(--color-paper);
            border-bottom: 1px solid var(--hairline-strong);
            font-family: var(--font-mono); font-size: 0.7rem;
            text-transform: uppercase; letter-spacing: 0.08em;
            font-weight: 500; background: rgba(0,0,0,0.3);
            text-align: left;
        }
        .ledger th:last-child { text-align: right; }
        .ledger td {
            padding: 0.9rem 1.2rem; color: var(--color-text-high);
            border-bottom: 1px solid var(--hairline);
        }
        .ledger td:last-child { text-align: right; font-family: var(--font-mono); font-weight: 500; }
        .ledger tr:last-child td { border-bottom: none; }
        .ledger tbody tr:hover td { background: rgba(255,255,255,0.015); color: var(--color-paper); }
        .loss { color: var(--color-rust); }
        .profit { color: var(--color-sage); }
        .muted { color: var(--color-text-low); }

        /* ═══════════════════════════════════════════════════════════
           5. CLIFF CHART
           ═══════════════════════════════════════════════════════════ */
        .chart-card {
            background: rgba(10,10,10,0.4);
            border: 1px solid var(--hairline); border-radius: 8px;
            padding: 1.5rem; position: relative;
        }
        .chart-card svg { width: 100%; height: auto; display: block; }

        /* ═══════════════════════════════════════════════════════════
           6. FOOTER
           ═══════════════════════════════════════════════════════════ */
        footer {
            padding: 2.5rem 0; display: flex;
            align-items: center; justify-content: space-between;
            font-family: var(--font-mono); font-size: 0.7rem;
            color: var(--color-text-low); letter-spacing: 0.05em;
        }
        .footer-links { display: flex; gap: 1.5rem; }
        .footer-link {
            color: var(--color-text-med); text-decoration: none;
            text-transform: uppercase;
            transition: color var(--duration-base) var(--ease-soft);
        }
        .footer-link:hover { color: var(--color-primary); }

        /* ═══════════════════════════════════════════════════════════
           7. SCROLL REVEAL
           ═══════════════════════════════════════════════════════════ */
        .reveal {
            opacity: 0; transform: translateY(30px);
            transition: opacity 0.8s cubic-bezier(0.16,1,0.3,1),
                        transform 0.8s cubic-bezier(0.16,1,0.3,1);
        }
        .reveal.is-visible { opacity: 1; transform: translateY(0); }

        /* ── Crosshair Panel (replication prompt §3) ── */
        .crosshair-panel { position: relative; border: 1px solid var(--hairline); background: rgba(255,255,255,0.02); padding: 1.5rem; border-radius: 4px; }
        .crosshair-panel::before {
            content: ""; position: absolute; top: 0; left: 0;
            width: 8px; height: 8px;
            border-top: 1px solid var(--color-primary);
            border-left: 1px solid var(--color-primary);
            pointer-events: none;
        }
        .crosshair-panel::after {
            content: ""; position: absolute; top: 0; right: 0;
            width: 8px; height: 8px;
            border-top: 1px solid var(--color-primary);
            border-right: 1px solid var(--color-primary);
            pointer-events: none;
        }
        .crosshair-panel-inner::before {
            content: ""; position: absolute; bottom: 0; left: 0;
            width: 8px; height: 8px;
            border-bottom: 1px solid var(--color-primary);
            border-left: 1px solid var(--color-primary);
            pointer-events: none;
        }
        .crosshair-panel-inner::after {
            content: ""; position: absolute; bottom: 0; right: 0;
            width: 8px; height: 8px;
            border-bottom: 1px solid var(--color-primary);
            border-right: 1px solid var(--color-primary);
            pointer-events: none;
        }

        /* ── Gradient Text (replication prompt) ── */
        .gradient-text {
            background: linear-gradient(110deg, var(--color-primary) 0%, var(--color-paper) 50%, var(--color-primary) 100%);
            background-size: 200% 200%;
            -webkit-background-clip: text; background-clip: text;
            -webkit-text-fill-color: transparent; color: transparent;
            animation: gradient-pan 9s ease infinite;
        }
        @keyframes gradient-pan {
            0%   { background-position: 0% 50%; }
            50%  { background-position: 100% 50%; }
            100% { background-position: 0% 50%; }
        }

        /* ── Entrance Animations + Stagger (replication prompt) ── */
        .fade-in-left { opacity: 0; transform: translateX(-20px); transition: opacity 0.6s var(--ease-soft), transform 0.6s var(--ease-bounce); }
        .fade-in-right { opacity: 0; transform: translateX(20px); transition: opacity 0.6s var(--ease-soft), transform 0.6s var(--ease-bounce); }
        .scale-in { opacity: 0; transform: scale(0.92); transition: opacity 0.5s var(--ease-soft), transform 0.5s var(--ease-bounce); }
        .fade-in-left.is-visible, .fade-in-right.is-visible, .scale-in.is-visible { opacity: 1; transform: none; }
        .stagger-1 { transition-delay: 0.05s; }
        .stagger-2 { transition-delay: 0.1s; }
        .stagger-3 { transition-delay: 0.15s; }
        .stagger-4 { transition-delay: 0.2s; }

        /* ── Live Dot (replication prompt companion) ── */
        .live-dot {
            display: inline-block; width: 8px; height: 8px;
            border-radius: 50%;
            background: var(--color-sage);
            box-shadow: 0 0 0 0 rgba(143,174,137,0.6);
            animation: live-pulse 2.4s ease-out infinite;
            margin-right: 6px; vertical-align: middle;
        }
