            75%  { transform: translate(4%, -2%) scale(1.08) rotate(3deg); }
            100% { transform: translate(-5%, 5%) scale(1.05) rotate(-4deg); }
        }

        @keyframes drift-a {
            from { transform: translate(0, 0) scale(1); }
            to { transform: translate(-8%, 10%) scale(1.1); }
        }

        @keyframes drift-b {
            from { transform: translate(0, 0) scale(1.1); }
            to { transform: translate(10%, -8%) scale(0.95); }
        }

        /* Container Structure */
        .page-wrapper {
            position: relative;
            z-index: 1;
            display: flex;
            min-height: 100vh;
        }

        /* Vertical Scrollspy Navigation */
        .scrollspy-nav {
            position: fixed;
            left: 0;
            top: 0;
            width: 90px;
            height: 100vh;
            border-right: 1px solid var(--hairline);
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            z-index: 100;
            background: rgba(0, 0, 0, 0.6);
            backdrop-filter: blur(8px);
        }

        .scrollspy-list {
            list-style: none;
            display: flex;
            flex-direction: column;
            gap: 2.5rem;
            align-items: center;
        }

        .scrollspy-item a {
            display: flex;
            flex-direction: column;
            align-items: center;
            text-decoration: none;
            color: var(--color-text-med);
            transition: color var(--duration-base) var(--ease-soft);
            position: relative;
        }

        .scrollspy-item a .num {
            font-family: var(--font-mono);
            font-size: 0.72rem;
            font-weight: 500;
            letter-spacing: 0.05em;
        }

        .scrollspy-item a .label {
            writing-mode: vertical-rl;
            text-orientation: mixed;
            transform: rotate(180deg);
            font-size: 0.75rem;
            font-weight: 400;
            text-transform: uppercase;
            letter-spacing: 0.18em;
            margin-top: 0.5rem;
            opacity: 0;
            height: 0;
            transition: opacity var(--duration-base) var(--ease-soft), height var(--duration-base) var(--ease-soft);
        }

        .scrollspy-item a:hover .label,
        .scrollspy-item.active a .label {
            opacity: 1;
            height: auto;
            margin-top: 0.8rem;
        }

        .scrollspy-item a:hover,
        .scrollspy-item.active a {
            color: var(--color-primary);
        }

        .scrollspy-item.active a::before {
            content: "";
            position: absolute;
            left: -12px;
            top: 5px;
            width: 4px;
            height: 4px;
            border-radius: 50%;
            background-color: var(--color-primary);
        }

        /* Content Area */
        .main-content {
            margin-left: 90px;
            flex: 1;
            max-width: 1300px;
            padding: 0 4rem;
        }

        /* ==========================================================================
           3. HEADER & NAVIGATION
           ========================================================================== */
        header {
            position: sticky;
            top: 0;
            height: 90px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            border-bottom: 1px solid var(--hairline);
            background: rgba(0, 0, 0, 0.8);
            backdrop-filter: blur(12px);
            z-index: 90;
            margin-bottom: 3rem;
            width: 100%;
        }

        .logo-container {
            display: flex;
            align-items: center;
            gap: 0.75rem;
        }

        .logo-icon {
            width: 22px;
            height: 22px;
            background: var(--color-primary);
            clip-path: polygon(0 0, 100% 0, 100% 50%, 50% 100%, 0 50%);
        }

        .logo-text {
            font-family: var(--font-display);
            font-weight: 500;
            font-size: 1.15rem;
            letter-spacing: 0.12em;
            color: var(--color-paper);
            text-transform: uppercase;
        }

        nav {
            display: flex;
            align-items: center;
            gap: 2.5rem;
        }

        .nav-link {
            font-family: var(--font-mono);
            font-size: 0.8rem;
            color: var(--color-text-high);
            text-decoration: none;
            text-transform: uppercase;
            letter-spacing: 0.08em;
            cursor: pointer;
            transition: color var(--duration-base) var(--ease-soft);
        }

        .nav-link:hover {
            color: var(--color-primary);
        }

        .header-actions {
            display: flex;
            align-items: center;
            gap: 2rem;
        }

        /* Heartbeat Status Indicator */
        .pipeline-status {
            display: flex;
            align-items: center;
            gap: 0.5rem;
            font-family: var(--font-mono);
            font-size: 0.7rem;
            color: var(--color-text-med);
            letter-spacing: 0.05em;
        }

        .pipeline-bars {
            display: flex;
            align-items: flex-end;
            gap: 2px;
            height: 10px;
        }

        .pipeline-bar {
            width: 2px;
            background-color: var(--color-primary);
            border-radius: 1px;
            height: 4px;
        }

        .pipeline-bar:nth-child(1) { animation: beat 1.2s infinite alternate; }
        .pipeline-bar:nth-child(2) { animation: beat 1s infinite alternate 0.2s; }
        .pipeline-bar:nth-child(3) { animation: beat 1.4s infinite alternate 0.4s; }

        @keyframes beat {
            0% { height: 3px; }
            100% { height: 10px; }
        }

        /* SlotButton Component */
        .slot-btn {
            position: relative;
            display: inline-block;
            color: var(--color-paper);
            text-decoration: none;
            overflow: hidden;
            padding: 0.55rem 1.4rem;
            border: 1px solid var(--hairline-strong);
            border-radius: 999px;
            background: transparent;
            cursor: pointer;
            font-family: var(--font-mono);
            font-size: 0.78rem;
            font-weight: 500;
            letter-spacing: 0.08em;
            transition: background-color var(--duration-base) var(--ease-soft),
                        border-color var(--duration-base) var(--ease-soft);
        }

        .slot-btn:hover {
            background-color: var(--color-primary);
            border-color: var(--color-primary);
        }

        .slot-text-wrapper {
            position: relative;
            display: block;
            transition: transform 0.45s var(--ease-bounce);
        }

        .slot-text-default {
            display: block;
            transition: opacity 0.3s var(--ease-soft), transform 0.45s var(--ease-bounce);
        }

        .slot-text-hover {
            position: absolute;
            top: 100%;
            left: 0;
            width: 100%;
            display: block;
            color: var(--bg-base);
            font-weight: 600;
            pointer-events: none;
            opacity: 0;
            transform: translateY(-50%) scale(0.95);
            transition: opacity 0.3s var(--ease-soft), transform 0.45s var(--ease-bounce);
        }

        .slot-btn:hover .slot-text-wrapper {
            transform: translateY(-100%);
        }

        .slot-btn:hover .slot-text-default {
            opacity: 0;
            transform: scale(0.9);
        }

        .slot-btn:hover .slot-text-hover {
            opacity: 1;
            transform: translateY(-50%) scale(1);
        }

        /* Slot-Button underline accent on hover */
        .slot-btn::after {
            content: "";
            position: absolute;
            bottom: -1px;
            left: 50%;
            width: 0;
            height: 1px;
            background: var(--color-primary);
            transition: width 0.4s var(--ease-bounce), left 0.4s var(--ease-bounce);
            pointer-events: none;
        }

        .slot-btn:hover::after {
            width: 80%;
            left: 10%;
        }

        /* ==========================================================================
           4. HERO SECTION
           ========================================================================== */
        section {
            padding: 5rem 0;
            border-bottom: 1px solid var(--hairline);
            scroll-margin-top: 110px;
        }

        .hero-section {
            display: flex;
            flex-direction: column;
            justify-content: center;
            min-height: calc(85vh - 90px);
            padding: 2rem 0 5rem;
            border-bottom: 1px solid var(--hairline);
            position: relative;
        }

        .hero-frame-container {
            position: relative;
            padding: 3rem;
            margin-bottom: 2.5rem;
        }

        /* Animated Stellla Frame Drawing */
        .hero-frame-svg {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            pointer-events: none;
            overflow: visible;
        }

        .hero-frame-svg rect {
            fill: none;
            stroke: var(--hairline-strong);
            stroke-width: 1px;
            stroke-dasharray: 2000;
            stroke-dashoffset: 2000;
            animation: drawFrame 2.8s var(--ease-bounce) forwards 0.2s;
        }

        .hero-frame-svg line {
            stroke: var(--color-primary);
            stroke-width: 1.5px;
            stroke-dasharray: 100;
            stroke-dashoffset: 100;
            animation: drawLine 1.8s var(--ease-bounce) forwards 0.8s;
        }

        @keyframes drawFrame {
            to { stroke-dashoffset: 0; }
        }

        @keyframes drawLine {
            to { stroke-dashoffset: 0; }
        }

        /* Groovy decorative paths — Flowing lines */
        .hero-groovy-svg {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            pointer-events: none;
            overflow: visible;
            z-index: 1;
        }

        .groovy-path {
            stroke-linecap: round;
            transform-origin: center;
            animation: groovy-flow 12s ease-in-out infinite alternate;
        }

        .gp-1 { animation-delay: 0s; }
        .gp-2 { animation-delay: -4s; opacity: 0.1; }
        .gp-3 { animation-delay: -8s; opacity: 0.08; }

        @keyframes groovy-flow {
            0%   { transform: translateX(0) translateY(0); }
            50%  { transform: translateX(-15px) translateY(-8px); }
            100% { transform: translateX(0) translateY(0); }
        }

        .groovy-dot {
            animation: groovy-dot-float 8s var(--ease-soft) infinite alternate;
        }

        .gd-1 { animation-delay: 0s; }
        .gd-2 { animation-delay: -3s; }

        @keyframes groovy-dot-float {
            0%   { transform: translate(0, 0); opacity: 0.3; }
            50%  { transform: translate(10px, -15px); opacity: 0.6; }
            100% { transform: translate(-5px, 8px); opacity: 0.2; }
        }

        .hero-tagline {
            font-family: var(--font-mono);
            font-size: 0.85rem;
            color: var(--color-primary);
            text-transform: uppercase;
            letter-spacing: 0.18em;
            margin-bottom: 1.2rem;
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
        }

        .hero-tagline::before {
            content: "";
            display: inline-block;
            width: 6px;
            height: 6px;
            background-color: var(--color-primary);
            border-radius: 1px;
        }

        .hero-title {
            font-family: var(--font-display);
            font-weight: 300;
            font-size: clamp(2.4rem, 5.5vw, 4.8rem);
            line-height: 1.1;
            color: var(--color-paper);
            letter-spacing: 0.03em;
            text-transform: uppercase;
            margin-bottom: 2rem;
        }

        .hero-title span {
            font-weight: 600;
        }

        .hero-desc {
            font-size: 1.12rem;
            color: var(--color-text-high);
            max-width: 740px;
            line-height: 1.68;
            margin-bottom: 2.8rem;
        }

        .hero-actions {
            display: flex;
            align-items: center;
            gap: 1.5rem;
        }

        /* Secondary Ghost Button */
        .btn-outline {
            display: inline-block;
            font-family: var(--font-mono);
            font-size: 0.78rem;
            text-transform: uppercase;
            letter-spacing: 0.08em;
            text-decoration: none;
            color: var(--color-text-high);
            padding: 0.6rem 1.6rem;
            border: 1px solid var(--hairline);
            border-radius: 999px;
            transition: all var(--duration-base) var(--ease-soft);
        }

        .btn-outline:hover {
            color: var(--color-paper);
            border-color: var(--color-paper);
        }

        /* ==========================================================================
           5. SYSTEM STATS & GLASS KPI CARDS
           ========================================================================== */
        .kpi-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
            gap: 1.5rem;
            margin-bottom: 4rem;
        }

        .glass-card {
            background: linear-gradient(135deg, rgba(255,255,255,0.03) 0%, rgba(255,255,255,0.005) 100%);
            border: 1px solid var(--hairline);
            border-radius: 8px;
            padding: 1.8rem;
            transition: transform 0.35s var(--ease-bounce),
                        box-shadow 0.35s ease,
                        border-color 0.35s ease;
            position: relative;
        }

        .glass-card:hover {
            border-color: rgba(215, 255, 0, 0.15);
            transform: translateY(-2px);
            box-shadow: 0 8px 24px rgba(0, 0, 0, 0.4);
        }

        /* Crosshair corner markers — Frame-drawing pattern */
        .glass-card::before {
            content: "";
            position: absolute;
            top: -1px;
            left: -1px;
            width: 12px;
            height: 12px;
            border-top: 2px solid var(--color-primary);
            border-left: 2px solid var(--color-primary);
            opacity: 0;
            transition: opacity var(--duration-base) ease;
            pointer-events: none;
        }

        .glass-card::after {
            content: "";
            position: absolute;
            bottom: -1px;
            right: -1px;
            width: 12px;
            height: 12px;
            border-bottom: 2px solid var(--color-primary);
            border-right: 2px solid var(--color-primary);
            opacity: 0;
            transition: opacity var(--duration-base) ease, transform 0.5s var(--ease-bounce);
            pointer-events: none;
        }

        .glass-card:hover::before,
        .glass-card:hover::after {
            opacity: 1;
        }

        .glass-card:hover::after {
            transform: scale(1);
        }

        /* Secondary corner pair for full frame embrace */
        .glass-card .corner-tl,
        .glass-card .corner-br {
            display: none;
        }

        .glass-card .label {
            font-family: var(--font-mono);
            font-size: 0.72rem;
            color: var(--color-text-med);
            text-transform: uppercase;
            letter-spacing: 0.08em;
            margin-bottom: 0.75rem;
        }

        .glass-card .value {
            font-family: var(--font-mono);
            font-size: 2.2rem;
            font-weight: 500;
            color: var(--color-paper);
            line-height: 1.1;
            margin-bottom: 0.5rem;
        }

        .glass-card .value.accent {
            color: var(--color-primary);
        }

        .glass-card .meta {
            font-size: 0.8rem;
            color: var(--color-text-med);
        }

        /* ==========================================================================
           6. COMPONENT STYLING (Ledger, Badges, Tech Pills)
           ========================================================================== */
        .section-header {
            margin-bottom: 3.5rem;
        }

        .section-num {
            font-family: var(--font-mono);
            font-size: 0.8rem;
            color: var(--color-primary);
            letter-spacing: 0.1em;
            margin-bottom: 0.8rem;
            display: block;
        }

        .section-title {
            font-family: var(--font-display);
            font-weight: 400;
            font-size: 1.8rem;
            color: var(--color-paper);
            text-transform: uppercase;
            letter-spacing: 0.05em;
        }

        /* Tech Pills */
        .tech-pill-container {
            display: flex;
            flex-wrap: wrap;
            gap: 0.6rem;
            margin-top: 1.5rem;
        }

        .tech-pill {
            font-family: var(--font-mono);
            font-size: 0.72rem;
            padding: 0.3rem 0.8rem;
            border-radius: 999px;
            background: rgba(255, 255, 255, 0.03);
            border: 1px solid var(--hairline);
            color: var(--color-text-high);
            text-transform: uppercase;
        }

        .tech-pill:hover {
            border-color: rgba(215, 255, 0, 0.3);
            color: var(--color-paper);
            background: rgba(215, 255, 0, 0.04);
            box-shadow: 0 0 20px rgba(215, 255, 0, 0.03);
        }

        /* Findings Ledger Table — Crosshair frame */
        .table-responsive {
            width: 100%;
            overflow-x: auto;
            margin: 2rem 0;
            border: 1px solid var(--hairline);
            background: rgba(10, 10, 10, 0.4);
            border-radius: 4px;
        }

        .table-responsive::before {
            content: "";
            position: absolute;
            top: -1px;
            left: -1px;
            width: 10px;
            height: 10px;
            border-top: 1.5px solid rgba(215, 255, 0, 0.15);
            border-left: 1.5px solid rgba(215, 255, 0, 0.15);
            opacity: 1;
            transition: opacity 0.5s var(--ease-soft);
            pointer-events: none;
        }

        .ledger-table {
            width: 100%;
            border-collapse: collapse;
            font-family: var(--font-body);
            font-size: 0.88rem;
            text-align: left;
        }

        .ledger-table th {
            padding: 1rem 1.4rem;
            color: var(--color-paper);
            border-bottom: 1px solid var(--hairline-strong);
            font-family: var(--font-mono);
            font-size: 0.75rem;
            text-transform: uppercase;
            letter-spacing: 0.08em;
            font-weight: 500;
            background: rgba(0, 0, 0, 0.3);
        }

        .ledger-table td {
            padding: 1rem 1.4rem;
            color: var(--color-text-high);
            border-bottom: 1px solid var(--hairline);
        }

        .ledger-table tbody tr:hover td {
            background: rgba(255, 255, 255, 0.015);
            color: var(--color-paper);
        }

        .commodity-chip {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            font-family: var(--font-mono);
            font-size: 0.75rem;
            text-transform: uppercase;
        }

        .commodity-dot {
            width: 7px;
            height: 7px;
            border-radius: 1px;
        }

        .commodity-dot.onion  { background-color: var(--color-commodity-onion); }
        .commodity-dot.tomato { background-color: var(--color-commodity-tomato); }
        .commodity-dot.wheat  { background-color: var(--color-commodity-wheat); }
        .commodity-dot.potato { background-color: var(--color-commodity-potato); }

        .stat-badge {
            font-family: var(--font-mono);
            font-size: 0.72rem;
            padding: 0.15rem 0.5rem;
            border-radius: 2px;
            font-weight: 500;
        }

        .stat-badge.significant {
            background: rgba(143, 174, 137, 0.12);
            color: var(--color-sage);
            border: 1px solid rgba(143, 174, 137, 0.25);
        }

        .stat-badge.insignificant {
            background: rgba(255, 255, 255, 0.04);
            color: var(--color-text-med);
            border: 1px solid var(--hairline);
        }

        .stat-badge.risk {
            background: rgba(217, 102, 59, 0.12);
            color: var(--color-rust);
            border: 1px solid rgba(217, 102, 59, 0.25);
        }

        /* ==========================================================================
           7. DOCUMENTATION LAYOUT (Detailed text blocks)
           ========================================================================== */
        .doc-layout {
            display: grid;
            grid-template-columns: 3fr 2fr;
            gap: 3.5rem;
        }

        @media (max-width: 992px) {
            .doc-layout {
                grid-template-columns: 1fr;
                gap: 2.5rem;
            }
        }

        .doc-text h3 {
            font-family: var(--font-display);
            font-weight: 400;
            font-size: 1.25rem;
            color: var(--color-paper);
            text-transform: uppercase;
            letter-spacing: 0.05em;
            margin: 2.2rem 0 1rem;
        }

        .doc-text h3:first-child {
            margin-top: 0;
        }

        .doc-text p {
            margin-bottom: 1.2rem;
            color: var(--color-text-high);
            font-size: 0.95rem;
            line-height: 1.65;
        }

        .doc-text ul, .doc-text ol {
            margin-bottom: 1.5rem;
            margin-left: 1.5rem;
            color: var(--color-text-high);
            font-size: 0.95rem;
        }

        .doc-text li {
            margin-bottom: 0.5rem;
        }

        .doc-text code {
            font-family: var(--font-mono);
            font-size: 0.82rem;
            background: rgba(255, 255, 255, 0.04);
            border: 1px solid var(--hairline);
            padding: 0.1rem 0.35rem;
            border-radius: 3px;
            color: var(--color-primary);
        }

        .doc-sidebar {
            display: flex;
            flex-direction: column;
            gap: 2rem;
        }

        .doc-widget {
            border: 1px solid var(--hairline);
            background: linear-gradient(135deg, rgba(255,255,255,0.025) 0%, rgba(255,255,255,0.005) 100%);
            backdrop-filter: blur(8px);
            -webkit-backdrop-filter: blur(8px);
            border-radius: 8px;
            padding: 1.8rem;
            transition: transform 0.35s var(--ease-bounce),
                        border-color 0.35s ease,
                        box-shadow 0.35s ease;
            position: relative;
        }

        .doc-widget:hover {
            border-color: rgba(215, 255, 0, 0.15);
            transform: translateY(-2px);
            box-shadow: 0 8px 24px rgba(0, 0, 0, 0.4);
        }

        /* Doc-widget crosshair corners */
        .doc-widget::before {
            content: "";
            position: absolute;
            top: -1px;
            right: -1px;
            width: 10px;
            height: 10px;
            border-top: 1.5px solid rgba(215, 255, 0, 0.2);
            border-right: 1.5px solid rgba(215, 255, 0, 0.2);
            opacity: 0;
            transition: opacity 0.5s var(--ease-soft);
            pointer-events: none;
        }

        .doc-widget::after {
            content: "";
            position: absolute;
            bottom: -1px;
            left: -1px;
            width: 10px;
            height: 10px;
            border-bottom: 1.5px solid rgba(215, 255, 0, 0.2);
            border-left: 1.5px solid rgba(215, 255, 0, 0.2);
            opacity: 0;
            transition: opacity 0.5s var(--ease-soft);
            pointer-events: none;
        }

        .doc-widget:hover::before,
        .doc-widget:hover::after {
            opacity: 1;
        }

        .doc-widget-title {
            font-family: var(--font-mono);
            font-size: 0.78rem;
            color: var(--color-primary);
            text-transform: uppercase;
            letter-spacing: 0.08em;
            margin-bottom: 1.2rem;
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }

        .doc-widget-title::before {
            content: "";
            width: 5px;
            height: 5px;
            background: var(--color-primary);
        }

        /* Mermaid diagram wrapper */
        .mermaid-wrapper {
            background: rgba(0, 0, 0, 0.4);
            padding: 1.5rem 1rem;
            border-radius: 4px;
            border: 1px solid var(--hairline);
            overflow-x: auto;
            margin: 1.2rem 0;
        }
        .mermaid-wrapper .mermaid {
            max-width: 100%;
        }

        .alert-box {
            background: rgba(217, 102, 59, 0.04);
            border-left: 2px solid var(--color-rust);
            padding: 1.2rem;
            border-radius: 0 4px 4px 0;
            margin: 1.5rem 0;
        }

        .alert-box-title {
            font-family: var(--font-mono);
            font-size: 0.78rem;
            color: var(--color-rust);
            text-transform: uppercase;
            letter-spacing: 0.05em;
            margin-bottom: 0.5rem;
        }

        .alert-box-desc {
            font-size: 0.85rem;
            color: var(--color-text-high);
            margin: 0 !important;
        }

        /* ==========================================================================
           8. FOOTER
           ========================================================================== */
        footer {
            height: 120px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            border-top: 1px solid var(--hairline);
            margin-top: 6rem;
            font-family: var(--font-mono);
            font-size: 0.72rem;
            color: var(--color-text-low);
            letter-spacing: 0.05em;
        }

        .footer-links {
            display: flex;
            gap: 2rem;
        }

        .footer-link {
            color: var(--color-text-med);
            text-decoration: none;
            text-transform: uppercase;
            transition: color var(--duration-base) var(--ease-soft);
        }

        .footer-link:hover {
            color: var(--color-primary);
        }

        /* Scroll Reveal base style */
        .reveal {
            opacity: 0;
            transform: translateY(30px);
