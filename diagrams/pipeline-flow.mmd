}}%%
flowchart TD
    %% Stage 1: DATA INGESTION (Bright accent -- the "active" stage)
    subgraph S1["01 DATA INGESTION  | Nightly Cron 6 AM UTC"]
        direction TB
        A1["data.gov.in<br/>Mandi Prices API"] --> A2["fetch_prices.py<br/>Pagination Engine"]
        A3["IMD / GitHub<br/>Rainfall CSV"] --> A4["fetch_rainfall.py<br/>Sub-division Parser"]
        A5["Sentinel Hub<br/>NDVI Satellite"] --> A6["fetch_ndvi.py<br/>Vegetation Index"]
        A2 --> A7["http_client.py<br/>Retry + SSL + JSON"]
        A4 --> A7
        A6 --> A7
        A8["scheduler.py<br/>Orchestrator"] -.-> A2
        A8 -.-> A4
        A8 -.-> A6
    end

    %% Stage 2: DUCKDB WAREHOUSE (Medium brightness -- storing)
    subgraph S2["02 DUCKDB WAREHOUSE  | Idempotent Upsert"]
        direction TB
        B1["prices<br/>364K+ Records"]
        B2["rainfall<br/>Sub-division Monthly"]
        B3["ndvi<br/>District Vegetation"]
        B4["rdd_results<br/>Causal Estimates"]
        B5["source_metadata<br/>Freshness Tracking"]
        B6["last_ingest_status.json<br/>Timestamp"]
    end

    %% Stage 3: ANALYSIS & ML (Charted -- the value stage)
    subgraph S3["03 ANALYSIS & ML  | Causal + Forecast + Risk"]
        direction TB
        C1["rdd_engine.py<br/>Local Linear RDD<br/>Triangular Kernel<br/>McCrary Density Test"]
        C2["forecast.py<br/>Prophet vs LSTM<br/>Volatility Envelopes<br/>Honest Winner Callout"]
        C3["classifier.py<br/>XGBoost + SHAP<br/>Spike Risk Probability<br/>ROC-AUC 0.81"]
        C4["prescriptive.py<br/>Procurement Recommendations<br/>Confidence: HIGH/MOD/LOW"]
    end

    %% Stage 4: AI ORCHESTRATOR (Final processing)
    subgraph S4["04 AI ORCHESTRATOR  | Multi-Model Router"]
        direction TB
        D1["router.py<br/>Circuit Breaker<br/>Fallback Chain"]
        D2["orchestrator.py<br/>Tool-grounding<br/>Endpoint Selection"]
        D3["Nightly Narrative<br/>3-4 Sentence Report<br/>Commodity Summary"]
    end

    %% Stage 5: SERVING (Delivery)
    subgraph S5["05 SERVING  | Live Deployment"]
        direction TB
        E1["FastAPI Gateway<br/>mandiiq-api.onrender.com<br/>10 REST Endpoints"]
        E2["Streamlit Dashboard<br/>mandiiq.streamlit.app<br/>5 Interactive Pages"]
    end

    %% Main flow: thick arrows for primary path
    A7 ==> B1
    A7 -.-> B2
    A7 -.-> B3
    A8 ==> B6

    B1 ==> C1
    B1 ==> C2
    B1 ==> C3
    B2 --> C1
    B2 --> C2

    C1 ==> C4
    C2 ==> C4
    C3 ==> C4

    C4 ==> D1
    D1 ==> D2
    D2 ==> D3
    D3 ==> E1

    E1 <==> E2

